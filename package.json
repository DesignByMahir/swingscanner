{
  "name": "swingscanner",
  "version": "1.1.1",
  "description": "Local-first swing trading scanner, setup coach, and trading journal.",
  "author": "SwingScanner",
  "repository": {
    "type": "git",
    "url": "https://github.com/DesignByMahir/swingscanner.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "start": "next start",
    "icons:desktop": "node scripts/generate-desktop-icons.cjs",
    "desktop:prepare": "npm run icons:desktop && npm run build:web && node scripts/prepare-standalone.cjs",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --publish never --config electron-builder.config.cjs",
    "desktop:win": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never --config electron-builder.config.cjs",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac dmg zip --x64 --arm64 --publish never --config electron-builder.config.cjs",
    "desktop:publish": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish always --config electron-builder.config.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan:free": "tsx scripts/run-free-scan.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.108.1",
    "ai": "^6.0.199",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "p-limit": "^7.3.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "yahoo-finance2": "^3.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
